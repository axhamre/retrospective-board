{
  "name": "retrospective-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "pnpm prettier --write  && pnpm lint --fix",
    "format:check": "pnpm prettier --check",
    "lint": "eslint --cache",
    "prettier": "prettier --cache --log-level warn \"**/*.(js|ts|tsx)\"",
    "test": "turbo run test",
    "test:no-cache": "turbo run test --no-cache --force",
    "type-check": "tsc -b"
  },
  "engines": {
    "node": "^22.6.0"
  },
  "devDependencies": {
    "@tv4/node-kit-eslint": "^1.4.2",
    "@tv4/node-kit-tsconfig": "^1.4.2",
    "@types/node": "^22.16.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.24.0"
}
